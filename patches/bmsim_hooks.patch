diff --git a/codes/app_layer.py b/codes/app_layer.py
new file mode 100644
index 0000000..e6f7bdb
--- /dev/null
+++ b/codes/app_layer.py
@@ -0,0 +1,26 @@
+"""Application-layer hooks for BMSim (added for the SPADE-BDI integration test).
+
+BMSim's original behaviour is preserved when nothing overrides these hooks:
+every generator node sends a random integer to the sink at every generation slot.
+
+An external controller (e.g. a multi-agent bridge) can, *before* importing
+`event_driven`, set:
+
+  SCENARIO     dict overriding the deployment / node roles (see initializer.py)
+  on_generate  callable(node_id, sim_time_ms, destination, data, ttl)
+                 -> (destination_list, data, ttl)   to send a packet in this slot
+                 -> None                            to skip this generation slot
+  on_deliver   callable(node_id, message, sim_time_ms)
+                 called when a data packet (not heartbeat / friend poll)
+                 reaches one of its destination nodes.
+"""
+
+SCENARIO = None
+
+
+def on_generate(node_id, sim_time, destination, data, ttl):
+    return destination, data, ttl
+
+
+def on_deliver(node_id, msg, sim_time):
+    pass
